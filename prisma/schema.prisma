generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum DownloadCategory {
  NEWSLETTER
  FORMS
  GUIDES
  BROCHURES
}

enum DownloadStatus {
  DRAFT
  PUBLISHED
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id                       String     @id @default(cuid())
  title                    String     @db.VarChar(255)
  slug                     String     @unique @db.VarChar(255)
  excerpt                  String     @db.Text
  content                  Json
  coverImage               String?    @db.VarChar(1000)
  coverImagePublicId       String?    @db.VarChar(255)
  author                   String     @default("Inland Empire Lung & Sleep Institute") @db.VarChar(100)
  readingTimeMinutes       Int        @default(1)
  status                   PostStatus @default(DRAFT)
  publishedAt              DateTime?
  faqs                     Json?
  showDoctorsSection       Boolean    @default(false)
  doctorSpecialtyOverrides Json?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("blog_posts")
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique @db.VarChar(255)
  status         SubscriberStatus @default(ACTIVE)
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([subscribedAt])
  @@map("newsletter_subscribers")
}

model DownloadResource {
  id              String           @id @default(cuid())
  category        DownloadCategory
  title           String           @db.VarChar(255)
  subtitle        String?          @db.VarChar(255)
  issueNumber     Int?
  edition         String?          @db.VarChar(100)
  publicationDate DateTime?
  description     String           @db.Text
  fileUrl         String           @db.VarChar(1000)
  filePublicId    String?          @db.VarChar(255)
  fileSize        String?          @db.VarChar(50)
  pageCount       String?          @db.VarChar(50)
  topics          Json?
  featured        Boolean          @default(false)
  sortOrder       Int              @default(0)
  status          DownloadStatus   @default(PUBLISHED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([category])
  @@index([status])
  @@index([sortOrder])
  @@index([featured])
  @@index([publicationDate])
  @@map("download_resources")
}

model GalleryImage {
  id        String        @id @default(cuid())
  title     String        @db.VarChar(255)
  category  String        @default("Opening Day") @db.VarChar(100)
  src       String        @db.VarChar(1000)
  publicId  String?       @db.VarChar(255)
  alt       String        @db.VarChar(500)
  aspect    String?       @default("landscape") @db.VarChar(50)
  sortOrder Int           @default(0)
  status    GalleryStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([category])
  @@index([status])
  @@index([sortOrder])
  @@map("gallery_images")
}
