# Database Configuration
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Admin Authentication
ADMIN_EMAIL="admin@ielung.com"
ADMIN_PASSWORD="REPLACE_WITH_ACTUAL_PASSWORD"
JWT_SECRET="replace-with-at-least-32-char-cryptographically-random-secret"

# Cloudinary Media Configuration (Server-side only - NEVER prefix with NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"


# Microsoft Entra ID app registration credentials (keep the secret private).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Microsoft 365 mailbox the application is allowed to send as.
MICROSOFT_SENDER_EMAIL=

# Destination for website contact and appointment notifications.
CONTACT_TO=

# The app registration needs the Microsoft Graph application permission
# Mail.Send, with admin consent granted by your Microsoft 365 administrator.
