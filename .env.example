# Microsoft Entra ID app registration credentials (keep the secret private).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Microsoft 365 mailbox the application is allowed to send as.
MICROSOFT_SENDER_EMAIL=

# Destination for website contact and appointment notifications.
CONTACT_TO=

# The app registration needs the Microsoft Graph application permission
# Mail.Send, with admin consent granted by your Microsoft 365 administrator.
